@page "/"

<div style="margin: 0 15px;">
    <MudCarousel Class="mud-width-full" Style="height:200px; margin: auto;" ShowArrows="true" ShowBullets="true" EnableSwipeGesture="true" AutoCycle="true" TData="object">
        <MudCarouselItem Transition="Transition.Fade">
            <div class="d-flex justify-content-center align-items-center" style="height: 100%; width: 100%;">
                <MudImage Src="https://caracolillo.blob.core.windows.net/media-web-caracolillo/Banners/Banner1.jpeg" Elevation="25" Style="max-width: 100%; height: auto;" />
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="Transition.Fade">
            <div class="d-flex justify-content-center align-items-center" style="height: 100%; width: 100%;">
                <MudImage Src="https://caracolillo.blob.core.windows.net/media-web-caracolillo/Banners/Banner2.jpeg" Alt="Swedish Farm House" Elevation="25" Style="max-width: 100%; height: auto;" />
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="Transition.Fade">
            <div class="d-flex justify-content-center align-items-center" style="height: 100%; width: 100%;">
                <MudImage Src="https://cursosbaristacafe.com.mx/storage/2019/06/cafe-mexico.jpg" Alt="Swedish Farm House" Elevation="25" Style="max-width: 100%; height: auto;" />
            </div>
        </MudCarouselItem>
    </MudCarousel>
</div>