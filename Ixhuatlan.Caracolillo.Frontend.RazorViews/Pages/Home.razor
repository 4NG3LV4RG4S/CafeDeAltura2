@page "/"

<div style="margin: 15px 0; padding: 15px;">
    <MudCarousel Class="mud-width-full" Style="height: 600px; margin: auto;" ShowArrows="true" ShowBullets="true" EnableSwipeGesture="true" AutoCycle="true" TData="object">
        <MudCarouselItem Transition="Transition.Fade" Style="padding-bottom: 35px;">
            <div class="d-flex justify-content-center align-items-center" style="height: 100%; width: 100%;">
                <center>
                    <MudImage Src="https://caracolillo.blob.core.windows.net/media-web-caracolillo/Banners/Banner1.jpeg"
                              Elevation="25"
                              Style="width: 60%; height: 100%; object-fit: cover;" />
                </center>
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="Transition.Fade" Style="padding-bottom: 35px;">
            <div class="d-flex justify-content-center align-items-center" style="height: 100%; width: 100%;">
                <center>
                    <MudImage Src="https://caracolillo.blob.core.windows.net/media-web-caracolillo/Banners/Banner2.jpeg"
                              Alt="Swedish Farm House"
                              Elevation="25"
                              Style="width: 60%; height: 100%; object-fit: cover;" />
                </center>
            </div>
        </MudCarouselItem>
        <MudCarouselItem Transition="Transition.Fade" Style="padding-bottom: 35px;">
            <div class="d-flex justify-content-center align-items-center" style="height: 100%; width: 100%;">
                <center>
                    <MudImage Src="https://caracolillo.blob.core.windows.net/media-web-caracolillo/Banners/Banner3.jpeg"
                              Alt="Swedish Farm House"
                              Elevation="25"
                              Style="width: 60%; height: 100%; object-fit: cover;" />
                </center>
            </div>
        </MudCarouselItem>
    </MudCarousel>
    
    <MudCard Outlined="true" Elevation="25" Style="padding: 10px; background-color: #d3d3d3;">
        <MudText Typo="Typo.h1">
            Bienvenido a Caracolillo Café
        </MudText>
    </MudCard>
    

</div>