@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div>
    <MudLayout >
        <MudAppBar Style="background-color: #023831; height: 60px;" Dense="false" Elevation="6">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: white" Edge="Edge.Start" OnClick="OnExpandCollapseClick">
                @(_expanded ? "Collapse" : "Expand")
            </MudIconButton>
            <MudSpacer />
            <MudImage 
                Src="https://caracolillo.blob.core.windows.net/media-web-caracolillo/CaracolilloMediaImage/CaracolilloLotoPNG.png"
                Width="80"
                Height="62"
                Elevation="25" />
            <MudText Typo="Typo.h6">
                Caracolillo Café
            </MudText>
            <MudSpacer/>
        </MudAppBar>
        <MudCollapse Expanded="_expanded">
            <MudDrawer @bind-Open="_expanded" ClipMode="DrawerClipMode.Always" Elevation="25" Anchor="Anchor.Left">
                <MudDrawerContainer Style="padding: 10px;">
                    <NavMenu/>
                </MudDrawerContainer>
            </MudDrawer>
        </MudCollapse>
        <MudMainContent>
            <article class="content px-4">
                @Body
            </article>
        </MudMainContent>
    </MudLayout>
</div>